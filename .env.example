# Where your audiobook files live (read-only as far as AudioShelf is concerned)
AUDIOSHELF_LIBRARY=./library

# Database, extracted covers and the instance secret live here
AUDIOSHELF_DATA=./data

# Converted Audible imports land here and are served as part of the library.
# Defaults to <data>/imported, so the library folder can stay read-only.
# AUDIOSHELF_IMPORTS=./data/imported

# ffmpeg is only needed for .aax/.aaxc imports. Set full paths if they are not on PATH.
# AUDIOSHELF_FFMPEG=/usr/bin/ffmpeg
# AUDIOSHELF_FFPROBE=/usr/bin/ffprobe

# Where uploaded files are written. Defaults to the library folder; point it
# somewhere else if the library is mounted read-only.
# AUDIOSHELF_UPLOAD_DIR=./library
# Largest single upload, in GB.
AUDIOSHELF_UPLOAD_MAX_GB=8

AUDIOSHELF_HOST=0.0.0.0
AUDIOSHELF_PORT=8080

# Scan the library on boot (set to 0 for very large libraries on slow disks)
AUDIOSHELF_SCAN_ON_START=1

# Watch the library folder and rescan when books are added or removed, so you
# never have to press Scan. Set to 0 on network shares that do not support it.
AUDIOSHELF_WATCH=1
# How long to wait after the last change before rescanning (a big copy needs
# time to finish).
AUDIOSHELF_WATCH_DELAY_SEC=15

# Re-scan automatically every N minutes (0 disables). A backstop for when
# watching is unavailable.
AUDIOSHELF_SCAN_INTERVAL_MIN=0

# Session lifetime
AUDIOSHELF_SESSION_DAYS=30

# Set to 1 when running behind a reverse proxy that terminates TLS,
# so session cookies get the Secure flag from X-Forwarded-Proto.
AUDIOSHELF_TRUST_PROXY=0

# --- Generating audio from text ------------------------------------------
# A Google Cloud API key with the Text-to-Speech API enabled. The Generate
# page can store one instead, which is usually easier; this is here for
# hosted deployments that inject secrets as environment variables.
# Leave it unset and the feature stays switched off.
#AUDIOSHELF_GOOGLE_TTS_KEY=

# Default voice. Chirp 3 HD sounds the most like a narrator; Wavenet and
# Standard voices are cheaper and have a larger free tier.
#AUDIOSHELF_TTS_VOICE=en-US-Chirp3-HD-Charon

# Where generated books are written. Scanned as a library root.
#AUDIOSHELF_GENERATED=./data/generated

# Guard rail on one paste, so a stray Ctrl+V cannot spend an allowance.
#AUDIOSHELF_TTS_MAX_CHARS=2000000
